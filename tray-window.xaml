<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 玻璃美化菜单" Width="230" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" FontFamily="Segoe UI Variable, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <Style x:Key="MenuButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Panel}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Panel}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource Base}" Padding="7">
    <StackPanel>
      <TextBlock Text="Codex 玻璃美化" Foreground="{DynamicResource Secondary}" FontSize="11" Margin="14,8,0,6"/>
      <Button x:Name="TrayShow" Style="{StaticResource MenuButton}" Content="打开控制面板"/>
      <Button x:Name="TrayToggle" Style="{StaticResource MenuButton}" Content="关闭美化"/>
      <Border Height="1" Background="{DynamicResource Edge}" Margin="10,5"/>
      <Button x:Name="TrayExit" Style="{StaticResource MenuButton}" Content="退出软件"/>
    </StackPanel>
  </Border>
</Window>
